SECRET_KEY=change-me-long-random
DATABASE_URL=sqlite:///isp.db           # use postgresql+psycopg2://... in production
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now            # only used when no admin exists yet
BASE_URL=https://billing.example.com    # used for payment-gateway callbacks
COOKIE_SECURE=1                         # when served over HTTPS
AUTOMATION_INTERVAL=60                  # seconds, 0 = use cron instead
MIKROTIK_MOCK=0                         # 1 = simulated routers (demo)
TRUST_PROXY=1                           # when behind nginx
